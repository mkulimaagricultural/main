{
  "name": "mao-studio-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Secure MAo Studio Windows desktop client",
  "author": "Mkulima Agricultural Organization",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.mkulimaagricultural.studio",
    "productName": "MAo Studio",
    "artifactName": "MAo-Studio-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MAo Studio",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
